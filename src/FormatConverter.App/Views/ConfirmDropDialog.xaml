<Window x:Class="FormatConverter.App.Views.ConfirmDropDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认转换" Width="400" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#F5F7FA">
    <Border Background="White" CornerRadius="12" BorderBrush="#E3E8F0" BorderThickness="1" Margin="10">
        <StackPanel Margin="22,20">
            <TextBlock x:Name="MessageText" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
            <!-- 小字:是否不再提醒 -->
            <CheckBox x:Name="DontAskCheck" Margin="0,14,0,0" FontSize="12"
                      Foreground="#7A8699"
                      Content="不再提醒(以后拖入直接开始转换)"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,6">
                <Button Content="转换" Style="{StaticResource AccentButton}" Width="96" Height="34"
                        Click="OnConvert"/>
                <Button Content="取消" Style="{StaticResource ModernButton}" Width="96" Height="34"
                        Margin="8,0,0,0" Click="OnCancel"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
