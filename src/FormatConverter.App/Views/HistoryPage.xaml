<UserControl x:Class="FormatConverter.App.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20,16">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="🕘" FontSize="48" HorizontalAlignment="Center"/>
            <TextBlock Text="历史记录" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0"/>
            <TextBlock Text="转换历史（SQLite）将在 M3 后实施,这里会展示最近转换记录与结果。"
                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
