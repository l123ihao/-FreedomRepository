<Window x:Class="FormatConverter.App.Views.PresetManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:FormatConverter.App.ViewModels"
        Title="{Binding Title}" Width="460" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource BgBrush}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </Window.Resources>
    <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="12" Margin="10">
        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
            <StackPanel Margin="20,16">
                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="Bold"/>

                <!-- 名称 -->
                <TextBlock Text="名称" Style="{StaticResource FieldLabel}" Margin="0,14,0,0"/>
                <TextBox Style="{StaticResource ModernTextBox}" Margin="0,6,0,0"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- 目标格式 -->
                <TextBlock Text="目标格式" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                <ComboBox Style="{StaticResource ModernComboBox}" Margin="0,6,0,0"
                          ItemsSource="{Binding TargetFormats}"
                          DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedTarget}"/>

                <!-- 输出文件名模板 -->
                <TextBlock Text="输出文件名模板(留空 = 跟随全局输出设置)"
                           Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                <TextBox Style="{StaticResource ModernTextBox}" Margin="0,6,0,0"
                         Text="{Binding OutputTemplate, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="{Binding TemplateError}" Foreground="{DynamicResource DangerBrush}"
                           FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                           Text="占位符:(p) 所在目录 · (f) 文件名 · (i)/(o) 输入/输出扩展名 · (n:i)/(n:c) 序号/总数 · (d:yyyy-MM-dd) 日期 · (p:documents|music|videos|pictures|desktop) 特殊目录 · (d0)(d1) 目录层级。例:(p)(f)_小 或 sub/(f)"/>

                <!-- 转换后动作 -->
                <TextBlock Text="转换后动作(仅转换成功后执行)" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                <ComboBox Style="{StaticResource ModernComboBox}" Margin="0,6,0,0"
                          ItemsSource="{Binding ActionChoices}"
                          DisplayMemberPath="Label"
                          SelectedItem="{Binding SelectedAction}"/>

                <!-- 归档文件夹 -->
                <StackPanel Visibility="{Binding ShowArchive, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="归档文件夹(留空 = 输出所在目录\归档)"
                               Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,6,0,0"
                             Text="{Binding ArchiveFolder, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- 参数覆盖 -->
                <Expander Header="参数覆盖(留「继承全局设置」的项不覆盖)" Style="{StaticResource ModernExpander}"
                          Margin="0,14,0,0" IsExpanded="True">
                    <StackPanel Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="音频码率" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource ModernComboBox}" Margin="8,2"
                                      ItemsSource="{Binding BitrateChoices}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedBitrate}"/>
                            <TextBlock Grid.Row="1" Text="视频质量(CRF)" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource ModernComboBox}" Margin="8,2,6,0"
                                      ItemsSource="{Binding CrfChoices}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedCrf}"/>
                            <TextBlock Grid.Row="2" Text="视频模式" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                            <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource ModernComboBox}" Margin="8,2,6,0"
                                      ItemsSource="{Binding VideoModeChoices}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedVideoMode}"/>
                            <TextBlock Grid.Row="3" Text="硬件加速" Style="{StaticResource FieldLabel}" Margin="0,6,0,0"/>
                            <ComboBox Grid.Row="3" Grid.Column="1" Style="{StaticResource ModernComboBox}" Margin="8,2,6,0"
                                      ItemsSource="{Binding HardwareChoices}" DisplayMemberPath="Label"
                                      SelectedItem="{Binding SelectedHardware}"/>
                        </Grid>
                        <TextBlock Text="FFmpeg 自定义参数(高级,留空不用)" Style="{StaticResource FieldLabel}" Margin="0,12,0,0"/>
                        <TextBox Style="{StaticResource ModernTextBox}" Margin="0,6,0,0"
                                 Text="{Binding CustomFfmpegArgs, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Style="{StaticResource HintText}" Margin="0,6,0,0"
                                   Foreground="{DynamicResource WarnBrush}"
                                   Text="按空白/双引号切分,支持 {input}/{output} 占位符。参数会加在 -f 之前,请勿覆盖 muxer 声明;不当参数可能导致转换失败。"/>
                    </StackPanel>
                </Expander>

                <TextBlock Text="{Binding StatusError}" Foreground="{DynamicResource DangerBrush}"
                           FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                    <Button Content="确定" Style="{StaticResource AccentButton}" Width="96" Height="34" Click="OnOk"/>
                    <Button Content="取消" Style="{StaticResource ModernButton}" Width="96" Height="34"
                            Margin="8,0,0,0" Click="OnCancel"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
