<UserControl x:Class="FormatConverter.App.Views.ConvertPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FormatConverter.App.Converters"
             xmlns:models="clr-namespace:FormatConverter.Core.Models;assembly=FormatConverter.Core"
             AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <UserControl.Resources>
        <local:InverseBoolConverter x:Key="InverseBool"/>
        <!-- 行内状态文字:等待 + 不能转当前选中格式 → 红色「不兼容」
             (Text 绑定必须在样式 Setter 里,MultiDataTrigger 才能覆盖;控件局部值会压过触发器) -->
        <Style x:Key="FileStatusText" TargetType="TextBlock" BasedOn="{StaticResource StatusText}">
            <Setter Property="Text" Value="{Binding Status}"/>
            <Setter Property="Width" Value="56"/>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsIncompatible}" Value="True"/>
                        <Condition Binding="{Binding Status}" Value="等待"/>
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Text" Value="不兼容"/>
                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="58*"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="42*"/>
        </Grid.ColumnDefinitions>

        <!-- ============ 左栏:文件队列(拖放区 + 列表 + 操作栏) ============ -->
        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 头部工具条 -->
                <DockPanel Grid.Row="0" Margin="18,12,18,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="转换队列" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Left" Margin="10,0,0,0" FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="共 {0} 个文件">
                                <Binding Path="Files.Count"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Button DockPanel.Dock="Right" Content="清空列表" Style="{StaticResource ModernButton}"
                            Command="{Binding ClearCommand}" Padding="12,4"/>
                    <Button DockPanel.Dock="Right" Content="添加文件夹" Style="{StaticResource ModernButton}"
                            Command="{Binding AddFolderCommand}" Padding="12,4" Margin="0,0,8,0"/>
                    <Button DockPanel.Dock="Right" Content="选择文件" Style="{StaticResource ModernButton}"
                            Command="{Binding AddFilesCommand}" Padding="12,4" Margin="0,0,8,0"/>
                </DockPanel>

                <!-- 队列 / 空态拖放区 -->
                <Grid Grid.Row="1">
                    <ListView x:Name="FileList" ItemsSource="{Binding Files}"
                              Background="Transparent" BorderThickness="0"
                              SelectionMode="Extended"
                              SelectionChanged="OnFileSelectionChanged"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              Padding="18,0,10,10">
                        <ListView.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel/>
                            </ItemsPanelTemplate>
                        </ListView.ItemsPanel>
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <Border x:Name="bd" Background="{DynamicResource ItemBrush}"
                                                    BorderBrush="Transparent" BorderThickness="1.5"
                                                    CornerRadius="8" Padding="12,8"
                                                    SnapsToDevicePixels="True">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding IncompatibleText}"
                                      ToolTipService.IsEnabled="{Binding IsIncompatible}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>   <!-- 图标 -->
                                        <ColumnDefinition Width="*"/>      <!-- 名称+信息 -->
                                        <ColumnDefinition Width="Auto"/>   <!-- 状态 -->
                                        <ColumnDefinition Width="Auto"/>   <!-- 进度 -->
                                        <ColumnDefinition Width="Auto"/>   <!-- 移除 -->
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Emoji}" FontSize="20"
                                               VerticalAlignment="Center" Margin="2,0,12,0"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding SourcePath}"/>
                                        <TextBlock FontSize="12" Margin="0,2,0,0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}">
                                            <Run Text="{Binding SizeText, Mode=OneWay}"/><Run Text=" · 转为 "/><Run Text="{Binding TargetText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                                            <Run Text="{Binding PresetLabelText, Mode=OneWay}" Foreground="{DynamicResource AccentBrush}"/>
                                            <Run Text="{Binding MediaInfoText, Mode=OneWay}"/>
                                            <Run Text="{Binding PostActionNote, Mode=OneWay}" Foreground="{DynamicResource SuccessBrush}"/>
                                            <Run Text="{Binding IncompatibleText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Style="{StaticResource FileStatusText}"
                                               VerticalAlignment="Center" ToolTip="{Binding Error}"/>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                VerticalAlignment="Center" Width="150" Margin="8,0,8,0">
                                        <ProgressBar Style="{StaticResource ModernProgressBar}" Width="110"
                                                     Maximum="100" Value="{Binding Progress, TargetNullValue=0}"
                                                     VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ProgressText}" FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Width="34" Margin="6,0,0,0" TextAlignment="Right"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <Button Grid.Column="4" Style="{StaticResource RemoveButton}" Content="✕"
                                            Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding DataContext.IsConverting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBool}}"
                                            ToolTip="移除"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- 空态:大号虚线拖放区,文案跟随选中格式(命中穿透,投放冒泡到页面级 OnDrop) -->
                    <Grid Margin="18,0,18,14" IsHitTestVisible="False">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Files.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Rectangle Fill="{DynamicResource ItemBrush}" Stroke="{DynamicResource CardBorderBrush}"
                                   StrokeDashArray="4 3" RadiusX="8" RadiusY="8"/>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}">
                                <Run Text="把文件拖到这里,将转为右侧选中的 "/>
                                <Run Text="{Binding SelectedFormatText, Mode=OneWay}"
                                     Foreground="{DynamicResource AccentBrush}" FontWeight="Bold"/>
                            </TextBlock>
                            <TextBlock Text="也可把文件拖到右侧任意格式磁贴或预设上;或点上方「选择文件」"
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- 底部操作栏:状态 / 进度 / 按钮 -->
                <Grid Grid.Row="2" Margin="18,0,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding CurrentSpeed}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding StatusText}" FontSize="12" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0"
                                   VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,6,0,0">
                        <ProgressBar Style="{StaticResource ProgressBarLarge}" Maximum="100"
                                     Value="{Binding OverallProgress}"/>
                        <TextBlock Text="{Binding OverallProgress, StringFormat={}{0:0}%}" FontSize="12"
                                   VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="36"/>
                    </StackPanel>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <!-- 有「等待」文件且未在转换时显示 -->
                        <Button Content="开始转换" Command="{Binding StartCommand}"
                                MinWidth="116" Height="38" FontSize="14">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasWaitingFiles}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConverting}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- 有「失败」文件且未在转换时显示 -->
                        <Button Content="重试失败项" Command="{Binding RetryFailedCommand}"
                                MinWidth="96" Height="38" Margin="8,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFailedFiles}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConverting}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="取消" Style="{StaticResource ModernButton}"
                                Command="{Binding CancelCommand}" MinWidth="64" Height="38" Margin="8,0,0,0"
                                IsEnabled="{Binding IsConverting}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- ============ 右栏:预设 / 目标格式 / 输出设置 ============ -->
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- 预设 -->
                <Border Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,12">
                    <StackPanel>
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="预设" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button DockPanel.Dock="Right" Content="管理预设…" Style="{StaticResource ModernButton}"
                                    Padding="10,4" Command="{Binding OpenPresetManagerCommand}"/>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding PresetsVm.Items}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource PresetChip}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Content="{Binding Name}"
                                                  ToolTip="{Binding Summary}"
                                                  AllowDrop="True"
                                                  Drop="OnPresetChipDrop"
                                                  DragOver="OnPresetChipDragOver"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Text="{Binding PresetsVm.ActiveSummary}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>

                <!-- 目标格式:紧凑网格,右下角类别色点 -->
                <Border Style="{StaticResource CardStyle}" Padding="14,10" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="目标格式 — 点选磁贴,或直接把文件拖到磁贴上" FontSize="12"
                                   FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <ItemsControl ItemsSource="{Binding FormatTiles}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="4"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource FormatTile}"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  ToolTip="{Binding Format.DisplayName}"
                                                  AllowDrop="True"
                                                  Drop="OnTileDrop"
                                                  DragEnter="OnTileDragEnter"
                                                  DragLeave="OnTileDragLeave"
                                                  DragOver="OnTileDragOver">
                                        <Grid IsHitTestVisible="False">
                                            <TextBlock Text="{Binding ExtensionText}" FontSize="12" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <!-- 类别色点 -->
                                            <Ellipse Width="6" Height="6" HorizontalAlignment="Right"
                                                     VerticalAlignment="Bottom" Margin="0,0,3,3">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Format.Category}"
                                                                         Value="{x:Static models:FileCategory.Video}">
                                                                <Setter Property="Fill" Value="{DynamicResource FormatVideoBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Format.Category}"
                                                                         Value="{x:Static models:FileCategory.Audio}">
                                                                <Setter Property="Fill" Value="{DynamicResource FormatAudioBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Format.Category}"
                                                                         Value="{x:Static models:FileCategory.Document}">
                                                                <Setter Property="Fill" Value="{DynamicResource FormatDocumentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Format.Category}"
                                                                         Value="{x:Static models:FileCategory.Image}">
                                                                <Setter Property="Fill" Value="{DynamicResource FormatImageBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>
                                            <!-- 红色角标:该格式下 等待/转换中 的文件数 -->
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    MinWidth="16" Height="16" CornerRadius="8"
                                                    Background="#E5484D" Padding="3,0" Margin="0,2,2,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PendingCount}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding PendingCount}" Foreground="White" FontSize="10"
                                                           FontWeight="Bold" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </ToggleButton>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 输出设置 -->
                <Border Style="{StaticResource CardStyle}" Padding="14,10">
                    <StackPanel>
                        <TextBlock Text="输出设置" FontWeight="SemiBold"/>
                        <DockPanel Margin="0,8,0,0" LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left" Text="输出目录:" VerticalAlignment="Center"
                                       Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Button DockPanel.Dock="Right" Content="浏览…" Style="{StaticResource ModernButton}"
                                    Padding="10,4" Margin="6,0,0,0"
                                    Command="{Binding ChooseOutputDirectoryCommand}"/>
                            <TextBox Style="{StaticResource ModernTextBox}" VerticalAlignment="Center"
                                     Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <Expander Style="{StaticResource ModernExpander}" Header="高级设置" Margin="0,6,0,0">
                            <StackPanel>
                                <CheckBox Content="输出到原文件夹" Style="{StaticResource ModernCheckBox}"
                                          IsChecked="{Binding OutputToSourceFolder}"/>
                                <CheckBox Content="重名自动加序号" Style="{StaticResource ModernCheckBox}"
                                          Margin="0,10,0,0" IsChecked="{Binding AutoRename}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="音频码率:" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <ComboBox Style="{StaticResource ModernComboBox}" Width="76"
                                              VerticalAlignment="Center" Margin="6,0,0,0"
                                              ItemsSource="{Binding AudioBitrateChoices}"
                                              SelectedItem="{Binding AudioBitrateKbps}"/>
                                </StackPanel>
                                <CheckBox Content="视频优先无损复制" Style="{StaticResource ModernCheckBox}"
                                          Margin="0,10,0,0" IsChecked="{Binding VideoCopyFirst}"
                                          ToolTip="源视频编码与目标容器兼容时直接复制(秒级完成);不兼容则自动转码"/>
                                <CheckBox Content="硬件加速" Style="{StaticResource ModernCheckBox}"
                                          Margin="0,10,0,0" IsChecked="{Binding VideoHardwareAcceleration}"
                                          ToolTip="转码优先使用 NVENC/QSV/AMF 硬件编码,失败自动回退软件编码"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
