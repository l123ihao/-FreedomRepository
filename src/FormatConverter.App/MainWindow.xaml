<Window x:Class="FormatConverter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FormatConverter.App.Converters"
        Title="万能格式转换器" Height="690" Width="1100" MinHeight="600" MinWidth="960"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.Resources>
        <local:InverseBoolConverter x:Key="InverseBool"/>
    </Window.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 横幅 -->
            <RowDefinition Height="Auto"/>  <!-- 格式磁贴(投放区) -->
            <RowDefinition Height="*"/>     <!-- 转换队列 -->
            <RowDefinition Height="Auto"/>  <!-- 转换栏 -->
        </Grid.RowDefinitions>

        <!-- 横幅:桌面图 + 蓝色渐变遮罩 + 标题 -->
        <Border Grid.Row="0" Height="92" CornerRadius="12" ClipToBounds="True" Margin="0,0,0,14"
                SnapsToDevicePixels="True">
            <Grid>
                <Image Source="Assets/banner.jpg" Stretch="UniformToFill"/>
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#C21E5AD6" Offset="0"/>
                            <GradientStop Color="#99102B54" Offset="0.6"/>
                            <GradientStop Color="#40102B54" Offset="1"/>
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <DockPanel Margin="22,0">
                    <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="万能格式转换器" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="把文件直接拖到目标格式上,即刻转换"
                                   FontSize="12" Foreground="#D9FFFFFF" Margin="0,3,0,0"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="关于" Style="{StaticResource BannerButton}"
                            Command="{Binding AboutCommand}" VerticalAlignment="Center"/>
                </DockPanel>
            </Grid>
        </Border>

        <!-- 格式磁贴区:每个格式都是一个投放区 -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18,14,18,10" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="目标格式 — 点选格式,或直接把文件拖到格式上" FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <ItemsControl ItemsSource="{Binding FormatGroups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <TextBlock Text="{Binding Label}" Width="56" FontWeight="SemiBold"
                                           Margin="0,20,10,0" VerticalAlignment="Top"/>
                                <ItemsControl ItemsSource="{Binding Tiles}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Style="{StaticResource FormatTile}"
                                                          Width="136" Height="64"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          AllowDrop="True"
                                                          Drop="OnTileDrop"
                                                          DragEnter="OnTileDragEnter"
                                                          DragLeave="OnTileDragLeave"
                                                          DragOver="OnTileDragOver">
                                                <Grid IsHitTestVisible="False">
                                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding ExtensionText}" FontSize="16" FontWeight="Bold"
                                                                   HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{Binding Description}" HorizontalAlignment="Center"
                                                                   Margin="0,3,0,0">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="FontSize" Value="11"/>
                                                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Foreground" Value="#CCFFFFFF"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <!-- 红色角标:该格式下 等待/转换中 的文件数 -->
                                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                            MinWidth="18" Height="18" CornerRadius="9"
                                                            Background="#E5484D" Padding="4,0" Margin="0,4,4,0">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding PendingCount}" Value="0">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding PendingCount}" Foreground="White" FontSize="11"
                                                                   FontWeight="Bold" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </ToggleButton>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- 转换队列:每个文件一张卡,永不"隐形" -->
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="18,12,18,8" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="转换队列" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <TextBlock DockPanel.Dock="Left" Margin="10,0,0,0" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="共 {0} 个文件">
                                <Binding Path="Files.Count"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                    <Button DockPanel.Dock="Right" Content="清空列表" Style="{StaticResource ModernButton}"
                            Command="{Binding ClearCommand}" Padding="12,4"/>
                    <Button DockPanel.Dock="Right" Content="添加文件夹" Style="{StaticResource ModernButton}"
                            Command="{Binding AddFolderCommand}" Padding="12,4" Margin="0,0,8,0"/>
                    <Button DockPanel.Dock="Right" Content="选择文件" Style="{StaticResource ModernButton}"
                            Command="{Binding AddFilesCommand}" Padding="12,4" Margin="0,0,8,0"/>
                </DockPanel>
                <Grid Grid.Row="1">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Padding="18,0,10,10">
                        <ItemsControl ItemsSource="{Binding Files}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource ItemBrush}" CornerRadius="8"
                                            Padding="12,8" Margin="0,0,0,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>   <!-- 图标 -->
                                                <ColumnDefinition Width="*"/>      <!-- 名称+信息 -->
                                                <ColumnDefinition Width="Auto"/>   <!-- 状态 -->
                                                <ColumnDefinition Width="Auto"/>   <!-- 进度 -->
                                                <ColumnDefinition Width="Auto"/>   <!-- 移除 -->
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Emoji}" FontSize="20"
                                                       VerticalAlignment="Center" Margin="2,0,12,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding SourcePath}"/>
                                                <TextBlock FontSize="12" Margin="0,2,0,0"
                                                           Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="{Binding SizeText, Mode=OneWay}"/><Run Text=" · 转为 "/><Run Text="{Binding TargetText, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}"/>
                                                </TextBlock>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding Status}"
                                                       Style="{StaticResource StatusText}" Width="56"
                                                       VerticalAlignment="Center" ToolTip="{Binding Error}"/>
                                            <StackPanel Grid.Column="3" Orientation="Horizontal"
                                                        VerticalAlignment="Center" Width="150" Margin="8,0,8,0">
                                                <ProgressBar Style="{StaticResource ModernProgressBar}" Width="110"
                                                             Maximum="100" Value="{Binding Progress, TargetNullValue=0}"
                                                             VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding ProgressText}" FontSize="12"
                                                           Foreground="{StaticResource TextSecondaryBrush}"
                                                           Width="34" Margin="6,0,0,0" TextAlignment="Right"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <Button Grid.Column="4" Style="{StaticResource RemoveButton}" Content="✕"
                                                    Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.IsConverting, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBool}}"
                                                    ToolTip="移除"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- 空列表提示 -->
                    <TextBlock Text="暂无文件 — 把文件拖到上方的目标格式上,或点「选择文件」"
                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Files.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Grid>
        </Border>

        <!-- 转换栏 -->
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Padding="18,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <!-- 输出与选项 -->
                <WrapPanel Grid.Row="0">
                    <TextBlock Text="输出目录:" VerticalAlignment="Center" Margin="0,0,6,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Width="270" VerticalAlignment="Center"
                             Text="{Binding OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                    <Button Content="浏览…" Style="{StaticResource ModernButton}" Padding="10,4" Margin="6,0,0,0"
                            Command="{Binding ChooseOutputDirectoryCommand}"/>
                    <CheckBox Content="输出到原文件夹" Style="{StaticResource ModernCheckBox}" Margin="14,0,0,0"
                              VerticalAlignment="Center" IsChecked="{Binding OutputToSourceFolder}"/>
                    <Expander Style="{StaticResource ModernExpander}" Header="高级设置"
                              VerticalAlignment="Center" Margin="16,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox Content="重名自动加序号" Style="{StaticResource ModernCheckBox}"
                                      VerticalAlignment="Center" IsChecked="{Binding AutoRename}"/>
                            <TextBlock Text="音频码率:" VerticalAlignment="Center" Margin="14,0,6,0"
                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                            <ComboBox Style="{StaticResource ModernComboBox}" Width="76" VerticalAlignment="Center"
                                      ItemsSource="{Binding AudioBitrateChoices}"
                                      SelectedItem="{Binding AudioBitrateKbps}"/>
                            <CheckBox Content="视频优先无损复制" Style="{StaticResource ModernCheckBox}"
                                      VerticalAlignment="Center" Margin="14,0,0,0" IsChecked="{Binding VideoCopyFirst}"
                                      ToolTip="源视频编码与目标容器兼容时直接复制(秒级完成);不兼容则自动转码"/>
                        </StackPanel>
                    </Expander>
                </WrapPanel>
                <!-- 状态 + 整体进度 + 操作 -->
                <Grid Grid.Row="1" Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding StatusText}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0">
                        <ProgressBar Style="{StaticResource ProgressBarLarge}" Maximum="100"
                                     Value="{Binding OverallProgress}"/>
                        <TextBlock Text="{Binding OverallProgress, StringFormat={}{0:0}%}" FontSize="12"
                                   VerticalAlignment="Center" Margin="10,0,0,0" MinWidth="36"/>
                        <TextBlock Text="{Binding CurrentSpeed}" FontSize="12"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   VerticalAlignment="Center" Margin="14,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <!-- 有「等待」文件且未在转换时显示 -->
                        <Button Content="开始转换" Command="{Binding StartCommand}"
                                MinWidth="116" Height="38" FontSize="14">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasWaitingFiles}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConverting}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <!-- 有「失败」文件且未在转换时显示 -->
                        <Button Content="重试失败项" Command="{Binding RetryFailedCommand}"
                                MinWidth="96" Height="38" Margin="8,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernButton}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasFailedFiles}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConverting}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="取消" Style="{StaticResource ModernButton}"
                                Command="{Binding CancelCommand}" MinWidth="64" Height="38" Margin="8,0,0,0"
                                IsEnabled="{Binding IsConverting}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
