<Window x:Class="FormatConverter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FormatConverter.App.Views"
        Title="万能格式转换器" Height="720" Width="1200" MinHeight="640" MinWidth="1000"
        Icon="Assets/app.ico"
        WindowStartupLocation="CenterScreen">
    <Window.TaskbarItemInfo>
        <TaskbarItemInfo ProgressValue="{Binding TaskbarProgress}"
                         ProgressState="{Binding TaskbarState}"/>
    </Window.TaskbarItemInfo>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <!-- 侧边导航项:选中 = 浅蓝底 + 主色文字 -->
        <Style x:Key="NavRadio" TargetType="RadioButton">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="12,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentLightBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Gesture="Ctrl+O" Command="{Binding AddFilesCommand}"/>
        <KeyBinding Gesture="Ctrl+Shift+O" Command="{Binding AddFolderCommand}"/>
        <KeyBinding Gesture="Ctrl+K" Command="{Binding OpenCommandPaletteCommand}"/>
        <KeyBinding Key="Delete" Command="{Binding RemoveSelectedFilesCommand}"/>
        <KeyBinding Gesture="Ctrl+1" Command="{Binding NavigateCommand}" CommandParameter="convert"/>
        <KeyBinding Gesture="Ctrl+2" Command="{Binding NavigateCommand}" CommandParameter="tools"/>
        <KeyBinding Gesture="Ctrl+3" Command="{Binding NavigateCommand}" CommandParameter="history"/>
        <KeyBinding Gesture="Ctrl+4" Command="{Binding NavigateCommand}" CommandParameter="settings"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="204"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧导航栏 -->
        <Border Grid.Column="0" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="20,22,16,20">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="8" Background="{DynamicResource AccentBrush}"
                                Margin="0,0,10,0">
                            <TextBlock Text="🔄" FontSize="14" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="万能格式转换器" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="FormatConverter" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <TextBlock DockPanel.Dock="Bottom" Text="快捷键 Ctrl+K" FontSize="11"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="20,0,0,16"/>

                <StackPanel Margin="8,0">
                    <RadioButton Style="{StaticResource NavRadio}" GroupName="nav" Content="🔄  转换"
                                 IsChecked="{Binding IsConvertPage, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="convert"/>
                    <RadioButton Style="{StaticResource NavRadio}" GroupName="nav" Content="🛠  工具"
                                 IsChecked="{Binding IsToolsPage, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="tools"/>
                    <RadioButton Style="{StaticResource NavRadio}" GroupName="nav" Content="🕘  历史"
                                 IsChecked="{Binding IsHistoryPage, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="history"/>
                    <RadioButton Style="{StaticResource NavRadio}" GroupName="nav" Content="⚙  设置"
                                 IsChecked="{Binding IsSettingsPage, Mode=OneWay}"
                                 Command="{Binding NavigateCommand}" CommandParameter="settings"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 页面内容区:按 CurrentPageKey 显隐 -->
        <Grid Grid.Column="1">
            <views:ConvertPage>
                <views:ConvertPage.Style>
                    <Style TargetType="UserControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="convert">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:ConvertPage.Style>
            </views:ConvertPage>
            <views:ToolsPage>
                <views:ToolsPage.Style>
                    <Style TargetType="UserControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="tools">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:ToolsPage.Style>
            </views:ToolsPage>
            <views:HistoryPage>
                <views:HistoryPage.Style>
                    <Style TargetType="UserControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="history">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:HistoryPage.Style>
            </views:HistoryPage>
            <views:SettingsPage>
                <views:SettingsPage.Style>
                    <Style TargetType="UserControl">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentPageKey}" Value="settings">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </views:SettingsPage.Style>
            </views:SettingsPage>
        </Grid>

        <!-- 命令面板覆盖层(Ctrl+K) -->
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="20"
              Visibility="{Binding CommandPaletteVisible, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" MouseLeftButtonDown="OnPaletteOverlayClick"/>
            <Border Width="520" MaxHeight="440" HorizontalAlignment="Center" VerticalAlignment="Top"
                    Margin="0,72,0,0" Style="{StaticResource CardStyle}" Padding="10">
                <StackPanel>
                    <TextBox x:Name="PaletteQueryBox" Style="{StaticResource ModernTextBox}" FontSize="14"
                             Text="{Binding CommandPaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="OnPaletteKeyDown"/>
                    <ListBox x:Name="PaletteList" Margin="0,10,0,0" BorderThickness="0" Background="Transparent"
                             MaxHeight="320" ItemsSource="{Binding FilteredPaletteItems}"
                             SelectedItem="{Binding SelectedPaletteItem}"
                             MouseDoubleClick="OnPaletteItemDoubleClick"
                             KeyDown="OnPaletteKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" FontSize="13" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Hint}" FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="↑↓ 选择 · Enter 执行 · Esc 关闭" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,8,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
