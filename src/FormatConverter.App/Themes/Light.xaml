<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ============ 浅色主题色板 ============ -->
    <SolidColorBrush x:Key="BgBrush" Color="#F5F7FA"/>
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E3E8F0"/>
    <SolidColorBrush x:Key="ItemBrush" Color="#F8FAFD"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2E6BE6"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1E5AD6"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#EAF1FE"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2733"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#7A8699"/>

    <!-- 控件状态色 -->
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#EEF2F8"/>
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#D3DCE9"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#E2E9F4"/>
    <SolidColorBrush x:Key="ControlDisabledFgBrush" Color="#A8B2C2"/>
    <SolidColorBrush x:Key="ControlDisabledBgBrush" Color="#F3F5F9"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1A4FC0"/>
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#B9CCF5"/>
    <SolidColorBrush x:Key="TileHoverBrush" Color="#F2F7FF"/>
    <SolidColorBrush x:Key="RejectBgBrush" Color="#FDECEC"/>
    <SolidColorBrush x:Key="RejectBorderBrush" Color="#D93025"/>

    <!-- 语义色 -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#1E9E50"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#D93025"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#B26A00"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="#808080"/>

    <!-- 进度条/滚动条/下拉 -->
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#E8EDF5"/>
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#C9D2E0"/>
    <SolidColorBrush x:Key="ComboHighlightBrush" Color="#F0F5FF"/>
    <SolidColorBrush x:Key="ComboSelectedBrush" Color="#E8F0FE"/>
</ResourceDictionary>
