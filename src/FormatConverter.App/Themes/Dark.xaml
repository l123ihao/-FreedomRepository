<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- ============ 深色主题色板(Windows 11 暗色风格) ============ -->
    <SolidColorBrush x:Key="BgBrush" Color="#202020"/>
    <SolidColorBrush x:Key="CardBrush" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="CardBorderBrush" Color="#3C3C3C"/>
    <SolidColorBrush x:Key="ItemBrush" Color="#262626"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4C8BF5"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6BA1F8"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#2A3B5C"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA3B2"/>

    <!-- 控件状态色 -->
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ControlHoverBorderBrush" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#333333"/>
    <SolidColorBrush x:Key="ControlDisabledFgBrush" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="ControlDisabledBgBrush" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3B78E8"/>
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#33517F"/>
    <SolidColorBrush x:Key="TileHoverBrush" Color="#2E3D5C"/>
    <SolidColorBrush x:Key="RejectBgBrush" Color="#4A2424"/>
    <SolidColorBrush x:Key="RejectBorderBrush" Color="#E5484D"/>

    <!-- 语义色 -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#3FB36B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E5484D"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#D9A34A"/>
    <SolidColorBrush x:Key="NeutralBrush" Color="#9AA3B2"/>

    <!-- 进度条/滚动条/下拉 -->
    <SolidColorBrush x:Key="ProgressTrackBrush" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ScrollbarThumbBrush" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="ComboHighlightBrush" Color="#333C4A"/>
    <SolidColorBrush x:Key="ComboSelectedBrush" Color="#2E3D5C"/>
</ResourceDictionary>
